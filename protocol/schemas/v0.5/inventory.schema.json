{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reviewId",
    "revisionId",
    "verifiedAt",
    "manifest",
    "revision",
    "policy",
    "contextRevisions",
    "documents",
    "resources",
    "events",
    "policyResult",
    "exportId",
    "pdf",
    "representedEventIds",
    "renderedDiagrams",
    "diagnostics",
    "renderer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.5.0"
    },
    "kind": {
      "const": "audit-export-inventory"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contextRevisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "byteLength",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 1000
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "byteLength",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 10000
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "byteLength",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 10000
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "byteLength",
          "mediaType",
          "eventId",
          "revisionId"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "revisionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      },
      "maxItems": 10000
    },
    "policyResult": {
      "enum": [
        "not-evaluated",
        "satisfied",
        "unsatisfied",
        "conflicted"
      ]
    },
    "exportId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "representedEventIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      }
    },
    "renderedDiagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "diagramId",
          "sourceDigest",
          "svg"
        ],
        "properties": {
          "diagramId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "svg": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "byteLength",
              "mediaType"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "maxItems": 100
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 10000
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "clientVersion",
        "markdownVersion",
        "mermaidVersion",
        "pdfEngine",
        "fontSetDigest",
        "sanitizerVersion",
        "schemaSetDigest"
      ],
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1
        },
        "markdownVersion": {
          "type": "string",
          "minLength": 1
        },
        "mermaidVersion": {
          "type": "string",
          "minLength": 1
        },
        "pdfEngine": {
          "type": "string",
          "minLength": 1
        },
        "fontSetDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sanitizerVersion": {
          "type": "string",
          "minLength": 1
        },
        "schemaSetDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-markdown-review:schema:inventory:0.5"
}
