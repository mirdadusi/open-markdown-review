{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-markdown-review:schema:revision:0.2",
  "title": "Open Markdown Review immutable revision 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "reviewId", "createdAt", "createdBy", "rootDocument", "documents", "resources", "externalReferences", "mermaidDiagrams", "diagnostics", "renderer"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "id": { "$ref": "#/$defs/id" },
    "reviewId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "$ref": "#/$defs/actor" },
    "rootDocument": { "$ref": "#/$defs/relativePath" },
    "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/document" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "externalReferences": { "type": "array", "items": { "$ref": "#/$defs/externalReference" } },
    "mermaidDiagrams": { "type": "array", "items": { "$ref": "#/$defs/mermaid" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdownProfile", "mermaidVersion"],
      "properties": {
        "markdownProfile": { "const": "commonmark-gfm" },
        "mermaidVersion": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$" },
    "blobPath": { "type": "string", "pattern": "^(?:\\.review/)?blobs/sha256/[a-f0-9]{2}/[a-f0-9]{64}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "displayName": { "type": "string", "minLength": 1 } }
    },
    "storedContent": {
      "type": "object",
      "required": ["digest", "blobPath", "mediaType", "byteLength"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "blobPath": { "$ref": "#/$defs/blobPath" },
        "mediaType": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "document": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/storedContent" },
        { "required": ["path"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "mediaType": { "const": "text/markdown" } } }
      ],
      "unevaluatedProperties": false
    },
    "resource": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/storedContent" },
        {
          "required": ["id", "document", "originalReference", "sourceKind", "role", "capturedAt"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "document": { "$ref": "#/$defs/relativePath" },
            "originalReference": { "type": "string", "minLength": 1 },
            "sourceKind": { "enum": ["workspace", "remote", "data"] },
            "role": { "enum": ["image", "attachment"] },
            "alt": { "type": "string" },
            "capturedAt": { "type": "string", "format": "date-time" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "uri", "relation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "document": { "$ref": "#/$defs/relativePath" },
        "uri": { "type": "string", "format": "uri" },
        "label": { "type": "string" },
        "relation": { "const": "link" }
      }
    },
    "mermaid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "ordinal", "sourceDigest", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "document": { "$ref": "#/$defs/relativePath" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "document": { "$ref": "#/$defs/relativePath" },
        "reference": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
